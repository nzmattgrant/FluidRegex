<Project Sdk="MSTest.Sdk/4.5.1">

  <PropertyGroup>
    <!-- net48 runs the shipped netstandard2.0 build on the .NET Framework regex engine. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net48</TargetFrameworks>
    <RootNamespace>FluidRegex.Test</RootNamespace>
    <!-- VSTest runs the tests inside Microsoft's signed testhost instead of a freshly built test .exe,
         which endpoint-security policies on some machines refuse to start. -->
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluidRegex\FluidRegex.csproj" />
    <!-- ApiReferenceTests compares this page with the public API. -->
    <None Include="..\docs\api-reference.md" Link="api-reference.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
