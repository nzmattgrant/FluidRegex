<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== Build ========== -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <AssemblyName>FluidRegex</AssemblyName>
    <RootNamespace>FluidRegex</RootNamespace>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1901-NU1904 = NuGet audit advisories: report them, but don't let a new advisory break a release build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!-- Trim / AOT analyzers only run on the modern target. -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <!-- ========== NuGet package ========== -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>FluidRegex</PackageId>
    <!-- Single source of truth for the version. CI fails a release if the git tag (v0.1.0) doesn't match. -->
    <Version>0.1.0</Version>
    <Authors>nzmattgrant</Authors>
    <Copyright>Copyright (c) 2018-2026 nzmattgrant</Copyright>
    <Description>Build .NET regular expressions with method chains that read like a description of the text you want to find. You do not need to know regex syntax. Text is matched as written, a count always covers the whole piece, patterns are reusable, and the result is an ordinary System.Text.RegularExpressions.Regex. No dependencies.</Description>
    <PackageTags>regex;regular-expression;regular-expressions;fluent;fluent-api;fluent-interface;builder;readable;readable-regex;pattern</PackageTags>
    <PackageProjectUrl>https://github.com/nzmattgrant/FluidRegex</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nzmattgrant/FluidRegex.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/nzmattgrant/FluidRegex/releases</PackageReleaseNotes>

    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- From 1.0.0: <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion> -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- Compile-time polyfills only ([StringSyntax] on netstandard2.0); never a package dependency. -->
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <InternalsVisibleTo Include="FluidRegex.Test" />
  </ItemGroup>

</Project>
